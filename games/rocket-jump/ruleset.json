  "guide": {
    "ko": {
      "moves": [
        {
          "action": "Jump",
          "effect": "제자리에서 뛰면 내 로켓이 한 칸 올라간다"
        },
        {
          "action": "Squat",
          "effect": "운석 경보가 떴을 때 앉으면 방패가 켜진다"
        }
      ],
      "scoring": [
        {
          "rule": "reported",
          "text": "로켓 높이가 곧 점수다"
        },
        {
          "text": "경보 중에 앉으면 2칸 더, 못 막으면 3칸 내려간다"
        }
      ],
      "cautions": [
        "옆 사람과 팔 하나 이상 떨어져서 뛴다",
